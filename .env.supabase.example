# ========================================================
# Supabase & Vercel Environment Variables Configuration
# ========================================================

# 1. Supabase Connection String (Transaction Pooler - Port 6543)
# In Supabase Dashboard: Project Settings -> Database -> Connection string -> URI
# Mode: Transaction (port 6543)
# Example format:
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# 2. JWT Configuration (Generate a strong random string)
JWT_SECRET=ZB5v0es1pPSUd3QMA6un9hoo0_02hCTCdY35xnKvg9QgrmxTgLNh7jN4hLckXcRdmeqhiwLVI5JBdJtXMEvmZg
JWT_EXPIRY=86400

# 3. Application Settings
APP_ENV=production
APP_DEBUG=false
ALLOWED_ORIGINS=*

# Note: In Vercel Project Settings -> Environment Variables:
# Add `DATABASE_URL` with your Supabase Transaction Pooler URI.
